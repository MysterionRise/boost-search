# LLM Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LangSmith (Optional - for observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=modern-rag

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Alternative: sentence-transformers/all-MiniLM-L6-v2, text-embedding-3-small

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, ollama, anthropic
LLM_MODEL=gpt-4-turbo-preview  # or gpt-3.5-turbo, claude-3-opus, llama3
LLM_TEMPERATURE=0.0

# Search Configuration
SEARCH_TYPE=hybrid  # Options: vector, bm25, hybrid
RERANK_ENABLED=true
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
TOP_K_FINAL=3

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
